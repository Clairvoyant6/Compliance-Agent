# ─── ComplianceIQ Backend Environment ──────────────────────────────────────
# Copy to .env and fill in as needed. All variables have safe defaults.

# Database — SQLite by default, swap to any Postgres DSN (Supabase/Neon/AWS)
# DATABASE_URL=sqlite:///./compliance.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# LLM provider — one of: mock | groq | gemini | openai | claude
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional — override the default model for the chosen provider
# LLM_MODEL=llama-3.3-70b-versatile

# CORS — comma-separated list of allowed origins, or * for any
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email notifications (Resend). Leave empty to disable; the server will
# log instead of sending and continue running.
RESEND_API_KEY=
NOTIFY_FROM=ComplianceIQ <onboarding@resend.dev>

# Scheduler — toggle the daily digest cron job
ENABLE_SCHEDULER=true
# Cron schedule in Asia/Kolkata timezone (default: 08:00 daily)
# SCHEDULER_CRON=0 8 * * *
